# ══════════════════════════════════════════
# UDIHUB — Variáveis de Ambiente
# ══════════════════════════════════════════
# Copie este arquivo para .env.local e preencha os valores

# ── SUPABASE ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── ASAAS (Pagamentos) ──────────────────────
# Produção: https://www.asaas.com/api/v3
# Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=$seu_api_key_asaas
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=seu_token_webhook

# ── RESEND (Emails) ─────────────────────────
RESEND_API_KEY=re_sua_chave_aqui
RESEND_FROM_EMAIL=noreply@udihub.com.br

# ── APP ─────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=UDIHUB

# ── ADMIN ───────────────────────────────────
# Email do admin para notificações
ADMIN_EMAIL=Udihub@outlook.com
